{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/hook.sh --harness-check",
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.sh",
        "matcher": "Write"
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh"
      }
    ]
  }
}
