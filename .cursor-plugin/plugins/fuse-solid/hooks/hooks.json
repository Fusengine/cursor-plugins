{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/hook.sh --session-start solid",
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.sh solid",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh solid",
        "matcher": "Write",
        "timeout": 10
      }
    ]
  }
}
